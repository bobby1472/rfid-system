# คัดลอกไฟล์นี้เป็น .env แล้วใส่รหัสผ่านจริงของ PostgreSQL
# คำสั่ง:  copy .env.example .env

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ใส่รหัสผ่านตรงนี้
POSTGRES_DB=rfid-system

# ให้เครื่องอื่นในวง LAN (รวมถึง ESP8266) เรียก API ได้
APP_TIMEZONE=Asia/Bangkok

API_HOST=0.0.0.0
API_PORT=7777

# โดเมนที่อนุญาตให้เรียก API จากเบราว์เซอร์ (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
